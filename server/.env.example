# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string (required for production)
# Get this from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGO_URL=mongodb+srv://<CampusRecruitment>:<Password123>@cluster0.x74ly4e.mongodb.net/?appName=Cluster0

# Port for local development (Vercel ignores this)
PORT=5000

# Secret key for JWT signing — use a long, random, cryptographically strong string
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_KEY=your_super_secret_jwt_key_here_minimum_32_chars

# URL of the deployed frontend (used for CORS allow-list)
# Example: https://campus-recruitment.vercel.app
CLIENT_URL=https://your-frontend-app.vercel.app

# Set to 'production' on Vercel (Vercel sets this automatically)
NODE_ENV=production
