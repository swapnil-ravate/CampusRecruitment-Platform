# ─── Client Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NOTE: Only variables prefixed with VITE_ are exposed to the browser

# The base URL of your deployed backend API
# Example: https://campus-api.vercel.app/api/v1
# Leave empty for local dev (defaults to http://localhost:5000/api/v1 in api.js)
VITE_API_URL=https://your-backend-app.vercel.app/api/v1
